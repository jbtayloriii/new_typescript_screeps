{
	"compilerOptions": {
		"module": "ES2020",
		"lib": ["es2018"],
		"target": "es2018",
		"moduleResolution": "Node",
		"outDir": "dist",
		"baseUrl": "src/",
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["screeps", "node", "jest"]
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}